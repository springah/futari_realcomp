#!/bin/bash
# futari-realcomp -- the Steam Deck launcher (add this file as a Non-Steam Game; set the launch options/compat to none).
# Same environment as the macOS bundle's launcher (mac-build/launcher.c) and scripts/run_mac.sh; every value can be
# overridden from the environment. Saves in ./save, one log per session in ./logs.
cd "$(dirname "$(readlink -f "$0")")"
d(){ [ -z "${!1:-}" ] && export "$1=$2"; }
d RT_GAME_ROOT "$PWD/assets"; d XR_SHELL_XEX "$PWD/assets/default.xex"; d RT_SAVE "$PWD/save"; d RT_MODDLL_DIR "$PWD"
mkdir -p "$RT_SAVE" logs
[ -f "$RT_SAVE/435A07D7/00000001/systemdata.bin/savegame.bin" ] || { [ -d save_freshcard ] && cp -r save_freshcard/. "$RT_SAVE"/; }
d RT_BOOT_SHELL 1; d RT_THREADS 1; d RT_DEFERDRIVER 1; d RT_ASYNCIO 1; d RT_EHCONTAIN 1; d RT_AUDIOPUMP 1
d RT_AUDIO 1; d RT_AUDIOWORKER 1; d RT_AUDIOBRIDGE 1; d RT_CUEBRIDGE 1
d RT_VK 1; d RT_NVK 2; d RVK_PERSIST 1; d RVK_RENDER_FROM 1; d RVK_NOHALVE 1; d RVK_FIXVP 1; d RVK_BLEND 1; d RVK_REALALPHA 1
d RT_WALLPAPER 1; d RVK_TEXPITCH 1; d RVK_FMT3KEY 1; d RVK_GPFIELD 1; d RVK_C255 "0.00625:0.00390625:-1:0"
d RVK_RESALIAS 1; d RVK_RESFRESH 1; d RVK_FIXB2 1; d RVK_RESREAL 1; d RVK_HDR 0
d RVK_WINDOW 1; d RVK_WINSIZE 1280x800; d RVK_DIMFIX 1
d RT_NAVREAL 1; d RT_STARTWIRE 1; d RT_SNDQFREE 1; d RT_RESCACHE 1; d RT_HEAPLOCK 1
d RT_PAD_HOST 1; d RT_SAMPLES 0; d RVK_DUMPDIR /tmp
export DISABLE_VULKAN_RENDERDOC_CAPTURE=1
exec ./futari_combined 8208A2B8 0 "$XR_SHELL_XEX" 2> "logs/futari_$(date +%Y%m%d_%H%M%S).log"
