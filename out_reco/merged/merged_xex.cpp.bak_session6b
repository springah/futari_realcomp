static void rt_heapdump(uint8_t* base, const char* tag) {
    fprintf(stderr, "[heap] %-14s g887AD65C=%08X g887AD5D4=%08X root821F85A0=%08X\n",
        tag, PPC_LOAD_U32(0x887AD65C), PPC_LOAD_U32(0x887AD5D4), PPC_LOAD_U32(0x821F85A0));
    fflush(stderr);
}
