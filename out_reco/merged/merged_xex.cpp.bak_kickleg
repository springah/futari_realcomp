    if(tbl>=0x1000&&tbl<0xFFFF0000u) for(int s=0;s<100;++s) if(PPC_LOAD_U32(tbl+s*52)) ++occ;
    std::fprintf(stderr,"[tt] SPAWN#%d (%u,%u,%u) '%s' lr=0x%X occ=%d/100\n",i,r3,r4,r5,nm,(uint32_t)ctx.lr,occ);
  }
}
