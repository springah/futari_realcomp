        // 'DNBW'(0x444E4257)/'WBND'(0x57424E44) with a nearby WAVEBANKDATA dwFlags 0x0008000x
        // (streaming bit0: BGM/SYS_BGM=0x00080001, SE=0x00080000). Report the field + where the flag is.
        std::fprintf(stderr,"[enroll]   WB-hunt:");
