      m,n,(unsigned)ctx.lr,r4,w0,w1,w2,w3,(unsigned)PPC_LOAD_U32(0x887AD58Cu),(unsigned)PPC_LOAD_U8(0x887AD547u),(unsigned)PPC_LOAD_U32(0x887AD584u));
  }
