        n,ret,p1,side,idx,Bp,F54,mk,F0,mk0,PPC_LOAD_U8(0x884D95F1u),
        PPC_LOAD_U8(0x884D6CE8u),PPC_LOAD_U16(0x884D6CEAu),PPC_LOAD_U8(0x884D6DACu));
