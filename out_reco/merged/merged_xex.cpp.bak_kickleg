// merged_xex.cpp — Gate 2: make the booted shell load+drive the reco_normal game module.
// Linked into futari_merged ONLY (out_reco/merged/, excluded from both default *.cpp globs).
// Compiled with GAME headers (-I out_reco). Two parts:
//   (1) Xex loader BRIDGE — the game module is already resident in the merged address space,
//       so the shell's own load path (loader sub_821C8A80 → XexLoadImage +
//       XexGetProcedureAddress(ordinal 1)) resolves to it instead of re-loading.
//   (2) INJECTION — override the shell idle/render loop sub_821706E8 so that, on first entry
//       (after full shell boot, before idling), we run the shell's mode-select dispatcher
//       sub_821C3B90 (one level above the loader) + driver, then fall through to the real
//       loop (which now renders with the game active). This is the code-path equivalent of
//       a menu "start game", bypassing the terminate-on-advance menu.
//
// Recipe (verified by RE agent against decompressed default.xex strings):
//   Entry point is now sub_821C3B90, the shell's mode-select dispatcher: it reads a mode
//   selector out of modectx+104 and, internally, runs the modectx ctor sub_821C57B8, the
//   reco_normal loader clone sub_821C8A80 (NOT sub_821C2F58 = palm_abnormal; builds
//   "game:\media\Module\reco_normal.xex", calls XexLoadImage →hmodule@modectx+248 +
//   XexGetProcedureAddress(ord 1) →GameEntry@modectx+252), AND the critical tail setup our
//   old direct-loader-call bypass used to skip (this is why we now enter one level higher).
//   Selector value 8 routes the dispatcher's default branch to reco_normal.
//   driver sub_821C30B8 then sends GameEntry msgs 6,7,1,2,8,9 + a finalize vtable call.
//   modectx = zeroed >=256 bytes (use 512 — dispatcher touches more fields than the bare
//   loader did); single r3=modectx arg to every function.
#include "ppc_recomp_shared.h"
#include <cstdio>
#include <cstring>
#include <cstdint>
#include <cstdlib>
#include <atomic>
#include <algorithm>
#include <chrono>
#include <mutex>
#include <unordered_map>
#include <vector>
#include "win_compat.h"
#include <file.h>
#include <image.h>
extern std::atomic<long> g_import_calls;
extern "C" uint32_t rt_alloc(uint32_t size, uint32_t align);
extern "C" void rt_indirect_call(PPCContext& ctx, uint8_t* base, uint32_t target);
extern "C" void __imp__sub_821706E8(PPCContext& __restrict ctx, uint8_t* base);  // real idle/render loop

static void rt_heapdump(uint8_t* base, const char* tag) {
    fprintf(stderr, "[heap] %-14s g887AD65C=%08X g887AD5D4=%08X root821F85A0=%08X\n",
        tag, PPC_LOAD_U32(0x887AD65C), PPC_LOAD_U32(0x887AD5D4), PPC_LOAD_U32(0x821F85A0));
    fflush(stderr);
}
// GATE 3: the per-frame game-mode tick target. Defined in shell/gen/rt.cpp; the VdSwap hook
// there calls sub_821C3278(r3=g_game_tick_modectx) once per present when RT_GAMETICK is set.
// We set it to the INNER modectx after the GameEntry init driver completes, so the shell begins
// servicing the game's per-frame update (which the free-running game main thread is waiting on
// via its gate flag 0x887AC958 — see sub_88168C80 wrapper below).
extern "C" uint32_t g_game_tick_modectx;

// The resident game module: handle = image base (x360 convention), GameEntry = export ord 1.
static const uint32_t GAME_HMODULE    = 0x88000000u;
static const uint32_t GAME_ENTRY_ORD1 = 0x8824E698u;
static const uint32_t RECO_LOADER     = 0x821C8A80u;  // reco_normal loader clone (no longer called directly; see sub_821C3B90)
static const uint32_t GAME_DRIVER     = 0x821C30B8u;  // GameEntry message driver
static const uint32_t MODE_DISPATCH   = 0x821C3B90u;  // shell mode-select dispatcher (ctor+loader+tail setup)
static const uint32_t SINGLETON_ADDR  = 0x821F8588u;  // shell singleton watched pre/post dispatch
static const uint32_t GAME_XSTART     = 0x88070588u;  // module entry (_xstart): DllMain-style PROCESS_ATTACH dispatcher
static const uint32_t CB248_INIT      = 0x821CB248u;  // shell service-singleton ctor: RtlInitializeCriticalSection(0x821F8210) + pool-alloc + ExCreateThread(service thread), stores singleton -> 0x821F857C
static const uint32_t CB248_SINGLETON = 0x821F857Cu;  // singleton pointer written by CB248_INIT; GameEntry msg-1 struct+28 reads *(this)

static bool path_is_game(const uint8_t* base, uint32_t p){
  if(!p) return false;
  const char* s = (const char*)(base + p);
  return std::strstr(s,"reco")||std::strstr(s,"RECO")||std::strstr(s,"Module")||std::strstr(s,"module");
}

// FIX (data-section bridge): reco_normal.xex's real .data/.bss image bytes are never copied
// into guest memory by this bridge (unlike out_reco/harness.cpp's own xexpath-gated loader,
// which this merged binary's invocation does not use). That leaves every static/global in
// the game's .data section — including the FILE_INFO class-34 vtable object at guest
// 0x88252560 that sub_880865F0 (out_reco/ppc_recomp.3.cpp:14910) reads through — all-zero,
// so its vtable-slot reads resolve to null and callers (e.g. sub_88092ED8's record-parse
// loop) spin on a garbage count. Root cause + verification: see the RE recipe. Minimal fix:
// load the game XEX's DATA-bearing sections (skip the CODE section, already covered by the
// recompiler's own PPCFuncMappings host-function table) into guest memory once, before the
// game's DllMain/_xstart runs, mirroring harness.cpp's memcpy loop.
static void rt_load_game_data_sections(uint8_t* base){
  static const uint32_t CODE_BASE = 0x88070000u, CODE_SIZE = 0x1DEEB0u;
  auto f = LoadFile(std::getenv("XR_RECO_NORMAL") ? std::getenv("XR_RECO_NORMAL") : "reco_normal.xex");
  Image img = Image::ParseImage(f.data(), f.size());
  long sc = 0; unsigned long long by = 0;
  for(const auto& sN : img.sections){
    uint64_t b=(uint64_t)sN.base, z=(uint64_t)sN.size;
    if(!sN.data || z==0) continue;
    if(b < 0x88000000ull || b+z > 0x887B0000ull) continue;      // out of guest image bounds
    if(b == CODE_BASE && z == CODE_SIZE) continue;               // skip CODE: PPCFuncMappings already covers it
    std::memcpy(base+b, (const void*)sN.data, z);
    ++sc; by += z;
  }
  std::fprintf(stderr,"  [xex] loaded %ld game DATA sections (%llu bytes) from reco_normal.xex\n", sc, by);
  // [rapiden] (2026-07-24 RT-rapid leg): static image values of the game-settings cluster
  // 0x88449a14..1b and the factory-defaults table 0x88062d60..67. FUN_88134048 (ship input
  // decode) MASKS OUT the R.SHOT bit 0x40 when DAT_88449a19==0, and NOTHING in the decomp dump
  // ever writes a19 nonzero (the 8816a7xx config menu only round-trips it; the FUN_88138f00
  // options commit skips it) — so its load-time value decides whether rapid-fire can ever work.
  std::fprintf(stderr,"  [rapiden] static a14..1b = %02X %02X %02X %02X %02X %02X %02X %02X   defaults 62d60..67 = %02X %02X %02X %02X %02X %02X %02X %02X\n",
    base[0x88449a14u],base[0x88449a15u],base[0x88449a16u],base[0x88449a17u],
    base[0x88449a18u],base[0x88449a19u],base[0x88449a1au],base[0x88449a1bu],
    base[0x88062d60u],base[0x88062d61u],base[0x88062d62u],base[0x88062d63u],
    base[0x88062d64u],base[0x88062d65u],base[0x88062d66u],base[0x88062d67u]);
}

extern "C" {

// ---- (1) Xex bridge (strong; build_merged.sh weakens the shell-kernel return-0 stubs) ----
PPC_FUNC(__imp__XexLoadImage){
  g_import_calls++;
  uint32_t path=ctx.r3.u32, hout=ctx.r6.u32;
  const char* s = path ? (const char*)(base+path) : "(null)";
  if(path_is_game(base,path)){
    // One-time DllMain(PROCESS_ATTACH) call into the resident game module's real entry
    // (_xstart @ GAME_XSTART), BEFORE we hand back the hmodule — matches real XexLoadImage
    // semantics (module entry runs synchronously on the calling thread before the loader
    // returns). Without this the game's CRT heap is never initialized and its first
    // mallocs corrupt memory. Save the bridge's own in/out regs across the call since the
    // attach call clobbers volatiles (r3-r10 etc per rt_indirect_call/PPCContext copy).
    static std::atomic<bool> attached{false};
    bool exp=false;
    if(attached.compare_exchange_strong(exp,true)){
      // Load the game's real .data/.bss image bytes into guest memory BEFORE DllMain/_xstart
      // runs, so _initterm_e's static-ctor table and every other .data global (including the
      // 0x88252560 FILE_INFO vtable object) are populated instead of reading back as zero.
      rt_load_game_data_sections(base);
      PPCContext ic=ctx;
      ic.r3.u32=GAME_HMODULE;  // hmodule
      ic.r4.u32=1;             // DLL_PROCESS_ATTACH
      ic.r5.u32=0;             // reserved
      rt_indirect_call(ic,base,GAME_XSTART);
      std::fprintf(stderr,"  [xex] DllMain(PROCESS_ATTACH) -> r3=0x%X\n",ic.r3.u32);
      if(ic.r3.u32!=1){
        std::fprintf(stderr,"  [xex] WARNING: DllMain(PROCESS_ATTACH) returned r3=0x%X (expected 1) — continuing anyway\n",ic.r3.u32);
      }
      // ctx (the bridge's own r3/r6/etc) is untouched — we called through the copy `ic`.

      // Thread notify-list sentinel (sub_88083A10 walks this LIST_ENTRY at guest
      // 0x88252504/0x88252508 on every new game thread's xapi startup). Nothing in the
      // game ever inserts into this list, so a real xapi init would leave it self-pointing
      // (empty list). Our harness leaves it zeroed, so the walk chases garbage at guest
      // address 0 forever and the game thread never reaches main. Initialize it once here,
      // right after DllMain(PROCESS_ATTACH), matching what real xapi startup would do.
      PPC_STORE_U32(0x88252504u, 0x88252504u);  // notify-list sentinel Flink -> self (empty)
      PPC_STORE_U32(0x88252508u, 0x88252504u);  // Blink -> self
      std::fprintf(stderr,"  [xex] notify-list sentinel initialized\n");
      rt_heapdump(base, "post-attach");
    }
    if(hout) *(uint32_t*)(base+hout)=__builtin_bswap32(GAME_HMODULE);
    std::fprintf(stderr,"  [xex] XexLoadImage(\"%s\") -> resident hmodule=0x%08X\n",s,GAME_HMODULE);
    ctx.r3.u32=0;
  } else {
    std::fprintf(stderr,"  [xex] XexLoadImage(\"%s\") -> not the game module\n",s);
    if(hout) *(uint32_t*)(base+hout)=0;
    ctx.r3.u32=0xC0000135u;
  }
}
PPC_FUNC(__imp__XexGetProcedureAddress){
  g_import_calls++;
  uint32_t hmod=ctx.r3.u32, ordinal=ctx.r4.u32, fout=ctx.r5.u32;
  if(hmod==GAME_HMODULE && ordinal==1){
    if(fout) *(uint32_t*)(base+fout)=__builtin_bswap32(GAME_ENTRY_ORD1);
    std::fprintf(stderr,"  [xex] XexGetProcedureAddress(0x%08X, ord=%u) -> 0x%08X\n",hmod,ordinal,GAME_ENTRY_ORD1);
    ctx.r3.u32=0;
  } else {
    std::fprintf(stderr,"  [xex] XexGetProcedureAddress(0x%08X, ord=%u) -> not found\n",hmod,ordinal);
    if(fout) *(uint32_t*)(base+fout)=0;
    ctx.r3.u32=0xC0000225u;
  }
}
PPC_FUNC(__imp__XexGetModuleHandle){
  g_import_calls++;
  uint32_t name=ctx.r3.u32;
  ctx.r3.u32 = path_is_game(base,name) ? GAME_HMODULE : 0;
}

} // extern "C"

// ---- DEBUG wrappers (RT_DBGSPAWN=1): trace the game msg-2 boot routine + thread-spawn
// trampoline to see whether the game-main ExCreateThread(ctx=0x88168D48) is reached. ----
extern "C" void __imp__sub_8808FDF8(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_88083200(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_8807C0A8(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_8808DA28(PPCContext& __restrict, uint8_t*);
static bool dbgspawn(){ static bool on=std::getenv("RT_DBGSPAWN")!=nullptr; return on; }

// sub_8807C0A8: suspected grind loop; iteration count comes from *(u32*)(r5+28).
// Log the first 20 calls in full, then every 1,000,000th call; track total calls + max count seen.
// Logging is now UNGATED (always on, no RT_DBGSPAWN check). A corruption FIREWALL guards the
// call to the original: garbage args (r3==0, r5==0, r5 in kernel/negative range, or an absurd
// iteration count) drive ~65k scattered atomic writes across low guest memory in the original's
// internal loop, corrupting the main thread's guest stack. When guarded, skip the original
// entirely and return with ctx.r3.u64=0 instead.
static std::atomic<long long> g_c0a8_calls{0};
static std::atomic<uint32_t> g_c0a8_max_count{0};
PPC_FUNC(sub_8807C0A8){
  long long n = g_c0a8_calls.fetch_add(1)+1;
  if(n<=4) rt_heapdump(base, "c0a8-call");
  if(n<=4){ std::fprintf(stderr, "[r26] c0a8-call r26=%08X\n", (uint32_t)ctx.r26.u32); std::fflush(stderr); }
  uint32_t r3=ctx.r3.u32;
  uint32_t r5=ctx.r5.u32;
  uint32_t cnt = r5 ? PPC_LOAD_U32(r5+28) : 0;
  uint32_t prev = g_c0a8_max_count.load();
  while(cnt>prev && !g_c0a8_max_count.compare_exchange_weak(prev,cnt)) {}
  if(n<=20 || (n%1000000)==0){
    std::fprintf(stderr,"[c0a8] sub_8807C0A8 call#%lld r3=0x%X r4=0x%X r5=0x%X *(r5+28)=%u\n",
      n,r3,ctx.r4.u32,r5,cnt);
  }
  // RANK-8 FIREWALL RETIRED (2026-07-19): the corruption firewall was a symptom-patch for the
  // era when the game's .data was never loaded into guest memory (FILE_INFO vtable @0x88252560 == 0
  // => garbage args here). rt_load_game_data_sections() (XexLoadImage above) now populates .data, so
  // every observed call arrives with valid args (r3/r5 in heap range, *(r5+28) small) and the
  // original runs cleanly with r26 preserved. Verified: 0 GUARDED-SKIPs across boot AND a full
  // menu->field run. Keep the guard predicate as a DIAGNOSTIC only (log-and-continue); do NOT skip.
  bool would_guard = (r3==0 || r5==0 || r5>=0x80000000u || cnt>4096);
  if(would_guard){
    static std::atomic<long long> g{0}; long long gi=g.fetch_add(1)+1;
    if(gi<=8 || (gi%100000)==0)
      std::fprintf(stderr,"[c0a8] WOULD-GUARD (firewall retired; calling original) r3=%x r5=%x cnt=%u\n",r3,r5,cnt);
  }
  __imp__sub_8807C0A8(ctx,base);
}

// sub_8808DA28: cheap ENTER/EXIT trace, first 20 calls only.
static std::atomic<long long> g_da28_calls{0};
PPC_FUNC(sub_8808DA28){
  bool d=dbgspawn();
  long long n = g_da28_calls.fetch_add(1)+1;
  bool log = d && n<=20;
  rt_heapdump(base, "DA28-enter");
  if(n<=4){ std::fprintf(stderr, "[r26] DA28-enter r26=%08X\n", (uint32_t)ctx.r26.u32); std::fflush(stderr); }
  if(log) std::fprintf(stderr,"[dbg] sub_8808DA28 ENTER call#%lld r3=0x%X r4=0x%X r5=0x%X\n",n,ctx.r3.u32,ctx.r4.u32,ctx.r5.u32);
  uint32_t save26=ctx.r26.u32, save27=ctx.r27.u32, save28=ctx.r28.u32;
  __imp__sub_8808DA28(ctx,base);
  if(save26==0x88168D48u && ctx.r26.u32!=save26) std::fprintf(stderr,"[clob] sub_8808DA28 clobbered r26 0x88168D48 -> 0x%X\n",ctx.r26.u32);
  // FIX (RT_FIXCLOB): sub_8808DA28's recompiled body writes callee-saved r26 (and possibly
  // r27/r28) but its prologue only __savegprlr_29 (saves r29-r31), so those are never restored
  // -> corrupts the caller's r26 (game-main fn ptr) and every other saved-reg-dependent value.
  // Enforce the ABI contract the buggy recomp violates by restoring r26/r27/r28 to entry. This
  // is the true fix (vs the lr-keyed RT_FIXSPAWN stopgap) and repairs ALL clobbered spawns.
  if(std::getenv("RT_FIXCLOB")){ ctx.r26.u32=save26; ctx.r27.u32=save27; ctx.r28.u32=save28; }
  rt_heapdump(base, "DA28-exit");
  if(n<=4){ std::fprintf(stderr, "[r26] DA28-exit r26=%08X\n", (uint32_t)ctx.r26.u32); std::fflush(stderr); }
  if(log) std::fprintf(stderr,"[dbg] sub_8808DA28 EXIT call#%lld r3=0x%X\n",n,ctx.r3.u32);
}

static std::atomic<long long> g_fdf8_calls{0};
PPC_FUNC(sub_8808FDF8){
  bool d=dbgspawn();
  long long n = g_fdf8_calls.fetch_add(1)+1;
  rt_heapdump(base, "FDF8-enter");
  if(n<=4){
    uint32_t guard568 = PPC_LOAD_U32(0x887AD568u);
    uint32_t guard56C = PPC_LOAD_U32(0x887AD56Cu);
    std::fprintf(stderr, "[r26] FDF8-enter r26=%08X guard={%08X,%08X}\n", (uint32_t)ctx.r26.u32, guard568, guard56C);
    std::fflush(stderr);
  }
  if(d){
    uint32_t guard568 = PPC_LOAD_U32(0x887AD568u);
    uint32_t guard56C = PPC_LOAD_U32(0x887AD56Cu);
    std::fprintf(stderr,"[dbg] sub_8808FDF8 ENTER r3=0x%X r4=0x%X (imports=%ld) guard[0x887AD568]=0x%X guard[0x887AD56C]=0x%X\n",
      ctx.r3.u32,ctx.r4.u32,g_import_calls.load(),guard568,guard56C);
  }
  __imp__sub_8808FDF8(ctx,base);
  rt_heapdump(base, "FDF8-exit");
  if(n<=4){ std::fprintf(stderr, "[r26] FDF8-exit r26=%08X\n", (uint32_t)ctx.r26.u32); std::fflush(stderr); }
  if(d) std::fprintf(stderr,"[dbg] sub_8808FDF8 EXIT r3=0x%X (imports=%ld) c0a8_calls=%lld c0a8_max(r5+28)=%u\n",
    ctx.r3.u32,g_import_calls.load(),g_c0a8_calls.load(),g_c0a8_max_count.load());
}
PPC_FUNC(sub_88083200){
  // STOPGAP (RT_FIXSPAWN): sub_8808FDF8 sets the game-main fn ptr r26=0x88168D48 (literal @
  // ppc_recomp.4.cpp:14936) and passes r6=r26 to this trampoline (:15038), but a callee clobbers
  // the non-volatile r26 to a heap addr on the real-.data path, so the runner sub_8808F798
  // (mtctr r3;bctrl) calls garbage and the game main never runs. Force the correct fn ptr at THIS
  // exact spawn site (return addr lr=0x8808FF20) so sub_88168D48 runs. (Real fix = find the
  // clobbering callee; this proves the theory + unblocks downstream testing.)
  if(std::getenv("RT_FIXSPAWN") && (uint32_t)ctx.lr==0x8808FF20u && ctx.r6.u32!=0x88168D48u){
    std::fprintf(stderr,"[fixspawn] forcing game-main ctx r6 0x%X -> 0x88168D48\n",ctx.r6.u32);
    ctx.r6.u32=0x88168D48u;
  }
  if(dbgspawn()) std::fprintf(stderr,"[dbg] sub_88083200 SPAWN-trampoline ctx(r6)=0x%X start(r7)=0x%X lr=0x%X\n",ctx.r6.u32,ctx.r7.u32,(uint32_t)ctx.lr);
  __imp__sub_88083200(ctx,base);
}

// ---- RT_PUMPFIX: the streaming/decompress WORKER (sub_88092C28) waits on an event whose
// handle lives at guest 0x887ACD30 (companion "system live" handle at 0x887ACD34 — the
// queue-push signaler sub_880929C8 gates on it being non-null, then NtSetEvents *0xD30).
// In our harness nothing ever creates that pair -> worker's first wait fails -> the worker
// RETURNS immediately -> no decompress/commit completions ever run (root cause of the
// starved asset-commit flag 0x887AC973 that RT_LOADDONE papers over). Create the pair with
// REAL kernel events at worker entry if absent. This is missing-init HLE, not a state lie. ----
extern "C" void __imp__sub_88092C28(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__NtCreateEvent(PPCContext& __restrict, uint8_t*);
PPC_FUNC(sub_88092C28){
  if(std::getenv("RT_PUMPFIX") && PPC_LOAD_U32(0x887ACD30u)==0){
    uint32_t scratch = ctx.r1.u32 - 64;   // transient guest scratch below the worker's SP
    uint32_t h[2]={0,0};
    for(int k=0;k<2;++k){
      PPCContext ic=ctx; ic.r3.u32=scratch; ic.r4.u32=0; ic.r5.u32=1/*SynchronizationEvent*/; ic.r6.u32=0;
      __imp__NtCreateEvent(ic,base);
      h[k]=PPC_LOAD_U32(scratch);
    }
    PPC_STORE_U32(0x887ACD30u,h[0]);
    PPC_STORE_U32(0x887ACD34u,h[1]);
    std::fprintf(stderr,"[pumpfix] worker event pair created: *(0x887ACD30)=0x%X *(0x887ACD34)=0x%X\n",h[0],h[1]);
  }
  std::fprintf(stderr,"[pumpfix] worker sub_88092C28 ENTER (wait handle=0x%X)\n",PPC_LOAD_U32(0x887ACD30u));
  __imp__sub_88092C28(ctx,base);
  std::fprintf(stderr,"[pumpfix] worker sub_88092C28 RETURNED r3=0x%X\n",ctx.r3.u32);
}
// [scene] game-side commit tier: sub_8808E780 = scene-graph PUBLISHER (writes *(0x88699894));
// sub_8808E740 = sibling flag getter. If the publisher never fires, the game's title sprites
// never register -> title never "done". Log every call + the value published.
extern "C" void __imp__sub_8808E780(PPCContext& __restrict, uint8_t*);
PPC_FUNC(sub_8808E780){
  static std::atomic<long> n{0}; long i=n.fetch_add(1)+1;
  __imp__sub_8808E780(ctx,base);
  std::fprintf(stderr,"[scene] PUBLISH sub_8808E780 #%ld -> *(0x88699894)=0x%X (r3=0x%X r4=0x%X)\n",
    i, PPC_LOAD_U32(0x88699894u), ctx.r3.u32, ctx.r4.u32);
}
extern "C" void __imp__sub_8808E740(PPCContext& __restrict, uint8_t*);
PPC_FUNC(sub_8808E740){
  static std::atomic<long> n{0}; long i=n.fetch_add(1)+1;
  __imp__sub_8808E740(ctx,base);
  if(i<=4||i%2000==0) std::fprintf(stderr,"[scene] getter sub_8808E740 #%ld -> r3=0x%X\n",i,ctx.r3.u32);
}
// [gwork] game asset-commit worker queue push (sub_880929C8 — gates on 0x887ACD34 non-null
// then NtSetEvents *0xD30). Log to see if the game ever ENQUEUES a decompress/commit job.
extern "C" void __imp__sub_880929C8(PPCContext& __restrict, uint8_t*);
PPC_FUNC(sub_880929C8){
