extern "C" void __imp__sub_88091448(PPCContext& __restrict, uint8_t*);
PPC_FUNC(sub_88091448){
  bool gm = xr_gettid()==g_gm_loop_tid.load(std::memory_order_relaxed);
  if(gm) g_gm_stage.store(3,std::memory_order_relaxed);
