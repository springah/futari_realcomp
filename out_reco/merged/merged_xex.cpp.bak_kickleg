        for(int k=0;k<5;k++) off += std::snprintf(mk+off,sizeof(mk)-off,"%02X ",PPC_LOAD_U8(bbase+(uint32_t)k*0x24u));
      } else std::snprintf(mk,sizeof(mk),"(B out of range)");
