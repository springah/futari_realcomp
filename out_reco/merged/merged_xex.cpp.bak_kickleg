      ok?PPC_LOAD_U32(o+0x1ACu):0,ok?PPC_LOAD_U32(o+0x1B0u):0,
      ok?PPC_LOAD_U32(o+0x1B4u):0,ok?PPC_LOAD_U32(o+0x1C0u):0,ok?PPC_LOAD_U32(o+0x44u):0);
