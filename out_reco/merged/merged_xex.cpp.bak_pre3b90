// merged_xex.cpp — Gate 2: make the booted shell load+drive the reco_normal game module.
// Linked into futari_merged ONLY (out_reco/merged/, excluded from both default *.cpp globs).
// Compiled with GAME headers (-I out_reco). Two parts:
//   (1) Xex loader BRIDGE — the game module is already resident in the merged address space,
//       so the shell's own load path (loader sub_821C8A80 → XexLoadImage +
//       XexGetProcedureAddress(ordinal 1)) resolves to it instead of re-loading.
//   (2) INJECTION — override the shell idle/render loop sub_821706E8 so that, on first entry
//       (after full shell boot, before idling), we run the reco_normal loader+driver, then
//       fall through to the real loop (which now renders with the game active). This is the
//       code-path equivalent of a menu "start game", bypassing the terminate-on-advance menu.
//
// Recipe (verified by RE agent against decompressed default.xex strings):
//   reco_normal loader clone = sub_821C8A80 (NOT sub_821C2F58 = palm_abnormal). It internally
//   calls the modectx ctor sub_821C57B8, builds "game:\media\Module\reco_normal.xex", calls
//   XexLoadImage (→hmodule@modectx+248) + XexGetProcedureAddress(ord 1) (→GameEntry@modectx+252).
//   driver sub_821C30B8 then sends GameEntry msgs 6,7,1,2,8,9 + a finalize vtable call.
//   modectx = zeroed >=256 bytes (use 288); single r3=modectx arg to every function.
#include "ppc_recomp_shared.h"
#include <cstdio>
#include <cstring>
#include <cstdint>
#include <cstdlib>
#include <atomic>
extern std::atomic<long> g_import_calls;
extern "C" uint32_t rt_alloc(uint32_t size, uint32_t align);
extern "C" void rt_indirect_call(PPCContext& ctx, uint8_t* base, uint32_t target);
extern "C" void __imp__sub_821706E8(PPCContext& __restrict ctx, uint8_t* base);  // real idle/render loop

// The resident game module: handle = image base (x360 convention), GameEntry = export ord 1.
static const uint32_t GAME_HMODULE    = 0x88000000u;
static const uint32_t GAME_ENTRY_ORD1 = 0x8824E698u;
static const uint32_t RECO_LOADER     = 0x821C8A80u;  // reco_normal loader clone
static const uint32_t GAME_DRIVER     = 0x821C30B8u;  // GameEntry message driver

static bool path_is_game(const uint8_t* base, uint32_t p){
  if(!p) return false;
  const char* s = (const char*)(base + p);
  return std::strstr(s,"reco")||std::strstr(s,"RECO")||std::strstr(s,"Module")||std::strstr(s,"module");
}

extern "C" {

// ---- (1) Xex bridge (strong; build_merged.sh weakens the shell-kernel return-0 stubs) ----
PPC_FUNC(__imp__XexLoadImage){
  g_import_calls++;
  uint32_t path=ctx.r3.u32, hout=ctx.r6.u32;
  const char* s = path ? (const char*)(base+path) : "(null)";
  if(path_is_game(base,path)){
    if(hout) *(uint32_t*)(base+hout)=__builtin_bswap32(GAME_HMODULE);
    std::fprintf(stderr,"  [xex] XexLoadImage(\"%s\") -> resident hmodule=0x%08X\n",s,GAME_HMODULE);
    ctx.r3.u32=0;
  } else {
    std::fprintf(stderr,"  [xex] XexLoadImage(\"%s\") -> not the game module\n",s);
    if(hout) *(uint32_t*)(base+hout)=0;
    ctx.r3.u32=0xC0000135u;
  }
}
PPC_FUNC(__imp__XexGetProcedureAddress){
  g_import_calls++;
  uint32_t hmod=ctx.r3.u32, ordinal=ctx.r4.u32, fout=ctx.r5.u32;
  if(hmod==GAME_HMODULE && ordinal==1){
    if(fout) *(uint32_t*)(base+fout)=__builtin_bswap32(GAME_ENTRY_ORD1);
    std::fprintf(stderr,"  [xex] XexGetProcedureAddress(0x%08X, ord=%u) -> 0x%08X\n",hmod,ordinal,GAME_ENTRY_ORD1);
    ctx.r3.u32=0;
  } else {
    std::fprintf(stderr,"  [xex] XexGetProcedureAddress(0x%08X, ord=%u) -> not found\n",hmod,ordinal);
    if(fout) *(uint32_t*)(base+fout)=0;
    ctx.r3.u32=0xC0000225u;
  }
}
PPC_FUNC(__imp__XexGetModuleHandle){
  g_import_calls++;
  uint32_t name=ctx.r3.u32;
  ctx.r3.u32 = path_is_game(base,name) ? GAME_HMODULE : 0;
}

} // extern "C"

// ---- DEBUG wrappers (RT_DBGSPAWN=1): trace the game msg-2 boot routine + thread-spawn
// trampoline to see whether the game-main ExCreateThread(ctx=0x88168D48) is reached. ----
extern "C" void __imp__sub_8808FDF8(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_88083200(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_8807C0A8(PPCContext& __restrict, uint8_t*);
extern "C" void __imp__sub_8808DA28(PPCContext& __restrict, uint8_t*);
static bool dbgspawn(){ static bool on=std::getenv("RT_DBGSPAWN")!=nullptr; return on; }

// sub_8807C0A8: suspected grind loop; iteration count comes from *(u32*)(r5+28).
// Log the first 20 calls in full, then every 1,000,000th call; track total calls + max count seen.
static std::atomic<long long> g_c0a8_calls{0};
static std::atomic<uint32_t> g_c0a8_max_count{0};
PPC_FUNC(sub_8807C0A8){
  bool d=dbgspawn();
  long long n = g_c0a8_calls.fetch_add(1)+1;
  if(d){
    uint32_t r5=ctx.r5.u32;
    uint32_t cnt = r5 ? PPC_LOAD_U32(r5+28) : 0;
    uint32_t prev = g_c0a8_max_count.load();
    while(cnt>prev && !g_c0a8_max_count.compare_exchange_weak(prev,cnt)) {}
    if(n<=20 || (n%1000000)==0){
      std::fprintf(stderr,"[dbg] sub_8807C0A8 call#%lld r3=0x%X r4=0x%X r5=0x%X *(r5+28)=%u\n",
        n,ctx.r3.u32,ctx.r4.u32,r5,cnt);
    }
  }
  __imp__sub_8807C0A8(ctx,base);
}

// sub_8808DA28: cheap ENTER/EXIT trace, first 20 calls only.
static std::atomic<long long> g_da28_calls{0};
PPC_FUNC(sub_8808DA28){
  bool d=dbgspawn();
  long long n = g_da28_calls.fetch_add(1)+1;
  bool log = d && n<=20;
  if(log) std::fprintf(stderr,"[dbg] sub_8808DA28 ENTER call#%lld r3=0x%X r4=0x%X r5=0x%X\n",n,ctx.r3.u32,ctx.r4.u32,ctx.r5.u32);
  __imp__sub_8808DA28(ctx,base);
  if(log) std::fprintf(stderr,"[dbg] sub_8808DA28 EXIT call#%lld r3=0x%X\n",n,ctx.r3.u32);
}

PPC_FUNC(sub_8808FDF8){
  bool d=dbgspawn();
  if(d){
    uint32_t guard568 = PPC_LOAD_U32(0x887AD568u);
    uint32_t guard56C = PPC_LOAD_U32(0x887AD56Cu);
    std::fprintf(stderr,"[dbg] sub_8808FDF8 ENTER r3=0x%X r4=0x%X (imports=%ld) guard[0x887AD568]=0x%X guard[0x887AD56C]=0x%X\n",
      ctx.r3.u32,ctx.r4.u32,g_import_calls.load(),guard568,guard56C);
  }
  __imp__sub_8808FDF8(ctx,base);
  if(d) std::fprintf(stderr,"[dbg] sub_8808FDF8 EXIT r3=0x%X (imports=%ld) c0a8_calls=%lld c0a8_max(r5+28)=%u\n",
    ctx.r3.u32,g_import_calls.load(),g_c0a8_calls.load(),g_c0a8_max_count.load());
}
PPC_FUNC(sub_88083200){
  if(dbgspawn()) std::fprintf(stderr,"[dbg] sub_88083200 SPAWN-trampoline ctx(r6)=0x%X start(r7)=0x%X lr=0x%X\n",ctx.r6.u32,ctx.r7.u32,(uint32_t)ctx.lr);
  __imp__sub_88083200(ctx,base);
}

// ---- (2) idle-loop injection: load+drive reco_normal once, then run the real loop.
// NOTE: this MUST have C++ linkage (NOT extern "C") to override the recompiler's weak
// `sub_821706E8` (which the func-mapping table references by its C++-mangled name).
// Only __imp__sub_821706E8 is extern "C"; sub_X (the weak alias) is C++-mangled. ----
PPC_FUNC(sub_821706E8){
  static std::atomic<int> once{0};
  int exp=0;
  if(std::getenv("RT_LOADGAME") && once.compare_exchange_strong(exp,1)){
    uint32_t modectx = rt_alloc(288,16);
    std::memset(base+modectx,0,288);
    std::fprintf(stderr,"\n[loadgame] shell booted; injecting reco_normal load. modectx=0x%08X\n",modectx);
    { PPCContext ic=ctx; ic.r3.u32=modectx; rt_indirect_call(ic,base,RECO_LOADER); }
    uint32_t hmod=__builtin_bswap32(*(uint32_t*)(base+modectx+248));
    uint32_t entry=__builtin_bswap32(*(uint32_t*)(base+modectx+252));
    std::fprintf(stderr,"[loadgame] after loader sub_821C8A80: hmodule@+248=0x%08X GameEntry@+252=0x%08X\n",hmod,entry);
    // The shell driver sub_821C30B8 passes modectx+164 as GameEntry msg-2's arg and
    // modectx+180 as msg-8's arg. Standalone (futari_mode) proved the game spawns its real
    // main thread when msg-2 gets a valid (even zeroed) buffer; a NULL arg makes it bail
    // (thread ctx=0, no game main). So point +164/+180 at zeroed scratch buffers.
    if(entry){
      uint32_t c164=rt_alloc(512,16); std::memset(base+c164,0,512);
      uint32_t c180=rt_alloc(512,16); std::memset(base+c180,0,512);
      *(uint32_t*)(base+modectx+164)=__builtin_bswap32(c164);
      *(uint32_t*)(base+modectx+180)=__builtin_bswap32(c180);
      std::fprintf(stderr,"[loadgame] wired modectx+164=0x%08X +180=0x%08X (msg2/msg8 arg buffers)\n",c164,c180);
      { PPCContext ic=ctx; ic.r3.u32=modectx; rt_indirect_call(ic,base,GAME_DRIVER); }
      std::fprintf(stderr,"[loadgame] after driver sub_821C30B8: GameEntry init sequence sent. imports=%ld\n",g_import_calls.load());
    } else {
      std::fprintf(stderr,"[loadgame] loader did NOT resolve GameEntry — aborting drive\n");
    }
    std::fprintf(stderr,"[loadgame] entering real shell idle/render loop with game active\n\n");
  }
  __imp__sub_821706E8(ctx,base);
}
