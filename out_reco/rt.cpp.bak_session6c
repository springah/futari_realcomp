PPC_FUNC_IMPL(__imp__RtlInitAnsiString){ LOGN("RtlInitAnsiString");
  uint32_t dst=ctx.r3.u32, src=ctx.r4.u32; uint16_t len=0; if(src){const char*s=(const char*)(base+src); while(s[len]&&len<0xFFFE)++len;}
